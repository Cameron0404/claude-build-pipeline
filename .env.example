# Copy to .env and change what you need. Every value here is the default or a placeholder.
# bin/build-pipeline reads .env, so launchd and cron runs see the same settings.

# Where pipelines, runs, the queue and stage reports live.
BUILD_PIPELINE_HOME=~/.build-pipeline
# Where each build's git worktree is created (build-<slug>).
BUILD_PIPELINE_WORKTREES=~/dev
# IANA zone for queue times; empty means the machine's zone.
BUILD_PIPELINE_TZ=
# Model for every stage, passed to claude --model.
BUILD_PIPELINE_MODEL=opus
# How briefs name the person who asked for the build.
BUILD_PIPELINE_OWNER="the owner"

# The Claude Code CLI, and the arguments every headless run gets. Headless runs cannot answer
# permission prompts. Read the README's "Permissions" section first.
# Recommended: allow the commands builds need in ~/.claude/settings.json and keep acceptEdits.
# At your own risk, not recommended: "--permission-mode bypassPermissions" lets every unattended
# run execute any command without asking. Use it only in a disposable VM, container or account.
BUILD_PIPELINE_CLAUDE=claude
BUILD_PIPELINE_CLAUDE_ARGS="--permission-mode acceptEdits"
# Runs at once, and the usage percentages at which new stages are held.
BUILD_PIPELINE_MAX_RUNS=3
BUILD_PIPELINE_THRESHOLD=90
BUILD_PIPELINE_WEEKLY=95

# Paths stages may not edit (comma separated).
BUILD_PIPELINE_PROTECTED=.claude/,CLAUDE.md
# The house-style sentence in every brief; empty keeps the default (plain words, no em dashes).
BUILD_PIPELINE_STYLE_LINE=
# Optional: a writing guide with <!-- HOUSE-BLOCK start --> ... <!-- HOUSE-BLOCK end -->.
BUILD_PIPELINE_STYLE_GUIDE=
# Optional: a command each stage runs on its report; {file} is replaced with the report path.
BUILD_PIPELINE_STYLE_CHECK=
# Optional: a command that receives a title and a note for each notification.
# Example on macOS: osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run'
BUILD_PIPELINE_NOTIFY=
# Another runner module (it must provide the interface in src/bp_runner.py).
BUILD_PIPELINE_RUNNER=bp_runner
